{
  "rewrites": [
    { "source": "/join-beta", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/admin-login", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/live-presence", "destination": "/index.html" },
    { "source": "/training", "destination": "/index.html" },
    { "source": "/presence-studio", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/beta-dashboard", "destination": "/index.html" },
    { "source": "/spatial-presence", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
