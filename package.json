{
  "name": "eidos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:desktop": "pnpm build:electron && concurrently -k \"pnpm dev\" \"node scripts/start-electron-dev.mjs\"",
    "build:desktop": "pnpm build && pnpm build:electron",
    "desktop": "electron dist-electron/main.js",
    "pack:desktop": "pnpm build:desktop && electron-builder --dir",
    "dist:win": "pnpm build:desktop && electron-builder --win nsis",
    "dist:mac": "pnpm build:desktop && electron-builder --mac dmg",
    "dist:linux": "pnpm build:desktop && electron-builder --linux AppImage",
    "hash:admin": "node --experimental-strip-types scripts/hash-admin-password.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pixiv/three-vrm": "^3.5.4",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.eidos.presence",
    "productName": "Eidos",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/mediapipe",
        "to": "mediapipe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/splash.html",
        "to": "splash.html"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Eidos-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Eidos-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "Eidos-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "description": "Privacy-first realistic visual presence for video calls using the user's real voice.",
  "author": "Eidos"
}
